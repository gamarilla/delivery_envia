msgstr "Error de Envía.com %(code)s: %(msg)s"

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com shipment error: %s"
msgstr "Error de envío de Envía.com: %s"

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com cancellation error: %s"
msgstr "Error de cancelación de Envía.com: %s"

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: this delivery method delivers to a branch ('a sucursal') but no branch could be found for the destination postal code %(zip)s. Set the branch manually on the customer's address (the 'Envia Branch Code' field) and try again."
msgstr "Envía.com: este método de envío entrega en sucursal ('a sucursal') pero no se encontró ninguna sucursal para el código postal de destino %(zip)s. Configure la sucursal manualmente en la dirección del cliente (campo 'Envia Branch Code') e intente de nuevo."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "The carrier %(carrier)s does not accept shipments split into several packages. This shipment weighs %(weight).2f kg and the packaging '%(package)s' takes up to %(max_weight).2f kg, so it was split into %(count)s packages. Raise the maximum weight of that package type (Inventory > Configuration > Package Types) or choose a bigger one, so the shipment fits in a single package."
msgstr "El transportista %(carrier)s no acepta envíos divididos en varios bultos. Este envío pesa %(weight).2f kg y el embalaje '%(package)s' admite hasta %(max_weight).2f kg, por lo que se dividió en %(count)s bultos. Aumente el peso máximo de ese tipo de paquete (Inventario > Configuración > Tipos de paquete) o elija uno más grande, para que el envío entre en un solo bulto."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "The carrier %(carrier)s does not accept shipments split into several packages, and this shipment (%(weight).2f kg) was split into %(count)s packages. Send it as a single package."
msgstr "El transportista %(carrier)s no acepta envíos divididos en varios bultos, y este envío (%(weight).2f kg) se dividió en %(count)s bultos. Envíelo como un solo bulto."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "The shipping service could not quote this route. Please try again; if it persists, check the package configuration."
msgstr "El servicio de envíos no pudo cotizar esta ruta. Intente de nuevo; si el problema persiste, revise la configuración de los paquetes."
