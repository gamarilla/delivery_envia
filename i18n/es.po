#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: the selected shipping service is not available or is incorrect for this route. Check the delivery method / carrier service code."
msgstr "Envía.com: el servicio de envío seleccionado no está disponible o es incorrecto para esta ruta. Revise el método de envío / código de servicio del transportista."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: the destination postal code or address is invalid. Check the customer's postal code and address."
msgstr "Envía.com: el código postal o la dirección de destino no son válidos. Verifique el código postal y la dirección del cliente."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: a destination branch is required for a 'to branch' shipment. Set the branch on the customer's address and try again."
msgstr "Envía.com: falta el código de sucursal de destino para un envío 'a sucursal'. Configure la sucursal en la dirección del cliente e intente de nuevo."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: missing shipment data — the recipient's phone number or the customs information. Complete it and try again."
msgstr "Envía.com: faltan datos del envío: el teléfono del destinatario o la información de aduana. Complételos e intente de nuevo."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: insufficient balance in the Envia.com account. Top up your Envia.com wallet and try again."
msgstr "Envía.com: saldo insuficiente en la cuenta de Envía.com. Recargue saldo en la billetera de Envía.com e intente nuevamente."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: the destination postal code could not be resolved. Check the customer's postal code and country."
msgstr "Envía.com: no se pudo resolver el código postal de destino. Verifique el código postal y el país del cliente."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
#, python-format
msgid "Envia.com: the carrier rejected the shipment (external carrier error or account not enabled). Retry; if it persists, contact Envia.com."
msgstr "Envía.com: el transportista rechazó el envío (error externo del transportista o cuenta no habilitada). Reintente; si el problema persiste, contacte a Envía.com."

#. module: delivery_envia
#: code:addons/delivery_envia/models/delivery_carrier.py:0
