#. module: delivery_envia
#: model:ir.model.fields,field_description:delivery_envia.field_product_product__envia_export_description
#: model:ir.model.fields,field_description:delivery_envia.field_product_template__envia_export_description
#: model_terms:ir.ui.view,arch_db:delivery_envia.product_template_envia_insurance
msgid "Customs Description"
msgstr "Descripción para aduana"

#. module: delivery_envia
#: model:ir.model.fields,help:delivery_envia.field_product_product__envia_export_description
#: model:ir.model.fields,help:delivery_envia.field_product_template__envia_export_description
msgid ""
"Product description for the customs declaration on international shipments "
"(e.g. 'Data Acquisition Kit for Dynamometer OEM'). Sent to Envia.com "
"together with the HS Code so duties and taxes can be classified and quoted "
"(prepaid DDP). Falls back to the product name when empty."
msgstr ""
"Descripción del producto para la declaración aduanera en envíos "
"internacionales (ej. 'Data Acquisition Kit for Dynamometer OEM'). Se envía "
"a Envia.com junto con el código HS para clasificar y cotizar impuestos y "
"aranceles (DDP prepago). Si está vacío se usa el nombre del producto."

#. module: delivery_envia
